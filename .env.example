# Supabase Project Settings → API / API Keys
NEXT_PUBLIC_SUPABASE_URL=BURAYA_PROJE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=BURAYA_PUBLISHABLE_KEY
# Secret key stays on the server. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=BURAYA_SECRET_KEY

# Connect → Session pooler URI (port 5432, IPv4 compatible).
# Keep [YOUR-PASSWORD] in the URI; put the password separately below.
DATABASE_URL=postgresql://postgres.PROJE_REF:[YOUR-PASSWORD]@SESSION_POOLER_HOST:5432/postgres
DATABASE_PASSWORD=BURAYA_VERITABANI_PAROLASI

# First administrator. Used only by npm run db:setup, not by normal login.
HEB_ADMIN_EMAIL=BURAYA_KENDI_EPOSTAN
HEB_ADMIN_PASSWORD=BURAYA_UYGULAMA_YONETICI_PAROLASI

# Optional CA PEM if your environment requires the project's CA certificate.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
